# Copy to .env.local and fill in. .env.local is gitignored (*.local).

# payments-toolkit-agent's /chat endpoint (its `pnpm run start:http`), or the
# local mock on :8787 (`pnpm run mock`) for offline frontend work. The cancel
# side-channel is derived from this as `<url>/<runId>/cancel`.
VITE_AGENT_CHAT_URL=http://localhost:3001/chat

# Supabase project — Project Settings → API. The publishable/anon key is
# browser-safe and ships in the bundle; never put the service_role/secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
